{
  "target": "linkedin",
  "description": "Paste-ready LinkedIn fields with LinkedIn's names and limits (headline 220, About 2,600, descriptions 2,000). LinkedIn has no import API for personal profiles, so this is a sheet to paste from. Public and network entries; approved; high or medium confidence. 'Before you paste' lists what LinkedIn will refuse: missing start dates, uncertain dates, military service without a title, press without a link.",
  "include": {
    "visibility": [
      "public",
      "network"
    ],
    "status": [
      "approved"
    ],
    "confidence": [
      "high",
      "medium"
    ]
  },
  "format": "text",
  "output": {
    "Headline": {
      "$fn": "truncate",
      "args": [
        {
          "$fn": "text",
          "args": [
            "$.person.headline"
          ]
        },
        220
      ]
    },
    "Location": {
      "$fn": "place",
      "args": [
        "$.person.location"
      ]
    },
    "Industry": "$.person.industry",
    "About": {
      "$fn": "truncate",
      "args": [
        {
          "$fn": "text",
          "args": [
            "$.person.summary"
          ]
        },
        2600
      ]
    },
    "Experience": {
      "$each": "$$.work",
      "$sort": "-startDate",
      "$map": {
        "Company (search LinkedIn for)": {
          "$fn": "orgNow",
          "args": [
            "$.organization"
          ]
        },
        "Company at the time": {
          "$fn": "orgNameAt",
          "args": [
            "$.organization",
            "$.startDate"
          ]
        },
        "Changes while there": {
          "$fn": "tenureNotes",
          "args": [
            "$.organization",
            "$.startDate",
            "$.endDate",
            "$.current"
          ]
        },
        "Employment type": {
          "$fn": "enumMap",
          "args": [
            "$.employmentType",
            {
              "$literal": {
                "fullTime": "Full-time",
                "partTime": "Part-time",
                "selfEmployed": "Self-employed",
                "freelance": "Freelance",
                "contract": "Contract",
                "internship": "Internship",
                "apprenticeship": "Apprenticeship",
                "seasonal": "Seasonal",
                "founder": "Full-time",
                "board": "Part-time",
                "advisor": "Part-time"
              }
            }
          ]
        },
        "Location": {
          "$fn": "place",
          "args": [
            "$.location"
          ]
        },
        "Location type": {
          "$fn": "enumMap",
          "args": [
            "$.workplaceType",
            {
              "$literal": {
                "onSite": "On-site",
                "hybrid": "Hybrid",
                "remote": "Remote"
              }
            }
          ]
        },
        "Skills": {
          "$fn": "lookup",
          "args": [
            "$.skills",
            "skills"
          ]
        },
        "Positions": {
          "$each": {
            "$fn": "positions",
            "args": [
              "$"
            ]
          },
          "$sort": "-startDate",
          "$map": {
            "Title": "$.title",
            "Dates": {
              "$fn": "dateRangeText",
              "args": [
                "$.startDate",
                "$.endDate",
                "$.current"
              ]
            },
            "Description": {
              "$fn": "truncate",
              "args": [
                {
                  "$fn": "joinLines",
                  "args": [
                    "$.summary",
                    {
                      "$fn": "responsibilityLines",
                      "args": [
                        "$"
                      ]
                    }
                  ]
                },
                2000
              ]
            }
          }
        }
      }
    },
    "Career breaks": {
      "$each": "$$.timeline",
      "$where": {
        "type": "careerBreak"
      },
      "$sort": "-startDate",
      "$map": {
        "Type": "$.reason",
        "Dates": {
          "$fn": "dateRangeText",
          "args": [
            "$.startDate",
            "$.endDate",
            "$.current"
          ]
        },
        "Description": {
          "$fn": "text",
          "args": [
            "$.summary"
          ]
        }
      }
    },
    "Experience: military service (add each as an Experience entry)": {
      "$each": "$$.service",
      "$where": {
        "kind": [
          "military",
          "reserve"
        ]
      },
      "$sort": "-startDate",
      "$map": {
        "Title": {
          "$fn": "coalesce",
          "args": [
            "$.rank",
            {
              "$fn": "text",
              "args": [
                "$.role"
              ]
            }
          ]
        },
        "Company (search LinkedIn for)": {
          "$fn": "org",
          "args": [
            "$.organization"
          ]
        },
        "Employment type": {
          "$literal": "Full-time"
        },
        "Dates": {
          "$fn": "dateRangeText",
          "args": [
            "$.startDate",
            "$.endDate",
            "$.current"
          ]
        },
        "Description": {
          "$fn": "truncate",
          "args": [
            {
              "$fn": "joinLines",
              "args": [
                "$.summary",
                "$.highlights"
              ]
            },
            2000
          ]
        }
      }
    },
    "Volunteering": {
      "$each": "$$.service",
      "$where": {
        "kind": [
          "scouting",
          "volunteer",
          "civic",
          "board",
          null
        ]
      },
      "$sort": "-startDate",
      "$map": {
        "Role": {
          "$fn": "coalesce",
          "args": [
            {
              "$fn": "text",
              "args": [
                "$.role"
              ]
            },
            "$.rank"
          ]
        },
        "Organization": {
          "$fn": "org",
          "args": [
            "$.organization"
          ]
        },
        "Cause": "$.cause",
        "Dates": {
          "$fn": "dateRangeText",
          "args": [
            "$.startDate",
            "$.endDate",
            "$.current"
          ]
        },
        "Description": {
          "$fn": "truncate",
          "args": [
            {
              "$fn": "joinLines",
              "args": [
                "$.summary",
                "$.highlights"
              ]
            },
            2000
          ]
        }
      }
    },
    "Education": {
      "$each": "$$.education",
      "$map": {
        "School": {
          "$fn": "org",
          "args": [
            "$.institution"
          ]
        },
        "Degree": "$.credential",
        "Field of study": {
          "$fn": "text",
          "args": [
            "$.area"
          ]
        },
        "Dates": {
          "$fn": "dateRangeText",
          "args": [
            "$.startDate",
            "$.endDate",
            false
          ]
        }
      }
    },
    "Licenses & certifications": {
      "$fn": "concatLists",
      "args": [
        {
          "$each": "$$.credentials",
          "$where": {
            "active": [
              true,
              null
            ]
          },
          "$map": {
            "Name": {
              "$fn": "concat",
              "args": [
                {
                  "$fn": "text",
                  "args": [
                    "$.name"
                  ]
                },
                {
                  "$if": "$.ratings",
                  "$then": {
                    "$fn": "concat",
                    "args": [
                      " – ",
                      {
                        "$fn": "join",
                        "args": [
                          "$.ratings"
                        ]
                      }
                    ]
                  }
                }
              ]
            },
            "Issuing organization": {
              "$fn": "org",
              "args": [
                "$.issuer"
              ]
            },
            "Issue date": {
              "$fn": "dateText",
              "args": [
                "$.issued"
              ]
            },
            "Credential ID": {
              "$fn": "visible",
              "args": [
                "$.credentialId",
                "$.credentialIdVisibility"
              ]
            },
            "Credential URL": "$.url"
          }
        },
        {
          "$each": {
            "$fn": "badgesNotListed",
            "args": [
              "$$.badges"
            ]
          },
          "$sort": "-validFrom",
          "$map": {
            "Name": {
              "$fn": "text",
              "args": [
                "$.achievement.name"
              ]
            },
            "Issuing organization": {
              "$fn": "org",
              "args": [
                "$.issuer"
              ]
            },
            "Issue date": {
              "$fn": "dateText",
              "args": [
                "$.validFrom"
              ]
            },
            "Expiration date": {
              "$fn": "dateText",
              "args": [
                "$.validUntil"
              ]
            },
            "Credential URL": "$.credential.url"
          }
        }
      ]
    },
    "Projects": {
      "$each": "$$.projects",
      "$sort": "-priority,-startDate",
      "$map": {
        "Project name": {
          "$fn": "text",
          "args": [
            "$.name"
          ]
        },
        "Dates": {
          "$fn": "dateRangeText",
          "args": [
            "$.startDate",
            "$.endDate",
            "$.current"
          ]
        },
        "Associated with": {
          "$fn": "org",
          "args": [
            "$.organization"
          ]
        },
        "Project URL": "$.url",
        "Description": {
          "$fn": "truncate",
          "args": [
            {
              "$fn": "joinLines",
              "args": [
                {
                  "$fn": "join",
                  "args": [
                    [
                      {
                        "$fn": "text",
                        "args": [
                          "$.role"
                        ]
                      },
                      {
                        "$if": "$.value",
                        "$then": {
                          "$fn": "concat",
                          "args": [
                            {
                              "$fn": "money",
                              "args": [
                                "$.value"
                              ]
                            },
                            " project"
                          ]
                        }
                      }
                    ],
                    " · "
                  ]
                },
                "$.summary",
                "$.highlights"
              ]
            },
            2000
          ]
        }
      }
    },
    "Honors & awards": {
      "$each": "$$.awards",
      "$map": {
        "Title": {
          "$fn": "text",
          "args": [
            "$.title"
          ]
        },
        "Issuer": {
          "$fn": "org",
          "args": [
            "$.awarder"
          ]
        },
        "Date": {
          "$fn": "dateText",
          "args": [
            "$.date"
          ]
        },
        "Description": {
          "$fn": "text",
          "args": [
            "$.summary"
          ]
        }
      }
    },
    "Publications": {
      "$each": "$$.publications",
      "$where": {
        "aboutPerson": [
          false,
          null
        ]
      },
      "$sort": "-date",
      "$map": {
        "Title": {
          "$fn": "text",
          "args": [
            "$.title"
          ]
        },
        "Publisher": {
          "$fn": "org",
          "args": [
            "$.publisher"
          ]
        },
        "Publication date": {
          "$fn": "dateText",
          "args": [
            "$.date"
          ]
        },
        "Publication URL": "$.url",
        "Description": {
          "$fn": "text",
          "args": [
            "$.summary"
          ]
        }
      }
    },
    "Languages": {
      "$each": "$$.languages",
      "$map": {
        "Language": {
          "$fn": "text",
          "args": [
            "$.name"
          ]
        },
        "Proficiency": {
          "$fn": "enumMap",
          "args": [
            "$.fluency",
            {
              "$literal": {
                "elementary": "Elementary proficiency",
                "limitedWorking": "Limited working proficiency",
                "professionalWorking": "Professional working proficiency",
                "fullProfessional": "Full professional proficiency",
                "native": "Native or bilingual proficiency"
              }
            }
          ]
        }
      }
    },
    "Skills (first 3 pinned)": {
      "$each": "$$.skills",
      "$sort": "-pinned,-priority",
      "$map": {
        "$fn": "text",
        "args": [
          "$.name"
        ]
      }
    },
    "Recommendations (LinkedIn shows only those written on LinkedIn; request the others there)": {
      "$each": {
        "$fn": "consented",
        "args": [
          "$$.recommendations"
        ]
      },
      "$sort": "-date",
      "$map": {
        "From": {
          "$fn": "authorLabel",
          "args": [
            "$"
          ]
        },
        "Relationship": "$.relationship.type",
        "Date": {
          "$fn": "dateText",
          "args": [
            "$.date"
          ]
        },
        "Text": {
          "$fn": "recommendationText",
          "args": [
            "$"
          ]
        },
        "Highlights": {
          "$if": {
            "$fn": "recommendationText",
            "args": [
              "$"
            ]
          },
          "$else": {
            "$fn": "recommendationText",
            "args": [
              "$",
              "highlights"
            ]
          }
        }
      }
    },
    "Featured": {
      "$each": "$$.media",
      "$where": {
        "featured": true
      },
      "$map": {
        "Title": {
          "$fn": "text",
          "args": [
            "$.title"
          ]
        },
        "Link or file": "$.url"
      }
    },
    "Featured: press about you (upload as a PDF or link)": {
      "$each": "$$.publications",
      "$where": {
        "aboutPerson": true
      },
      "$sort": "-date",
      "$map": {
        "Title": {
          "$fn": "text",
          "args": [
            "$.title"
          ]
        },
        "Publisher": {
          "$fn": "org",
          "args": [
            "$.publisher"
          ]
        },
        "Date": {
          "$fn": "dateText",
          "args": [
            "$.date"
          ]
        },
        "Link or file": "$.url"
      }
    },
    "Name pronunciation": {
      "$fn": "pronunciation",
      "args": []
    },
    "Before you paste": {
      "$fn": "concatLists",
      "args": [
        {
          "$fn": "gaps",
          "args": [
            "$$.work",
            {
              "$literal": {
                "label": "Experience",
                "required": [
                  "startDate"
                ],
                "exact": [
                  "startDate",
                  "endDate"
                ],
                "names": {
                  "startDate": "a start date"
                },
                "dateNames": {
                  "startDate": "start date",
                  "endDate": "end date"
                },
                "needMonth": true
              }
            }
          ]
        },
        {
          "$fn": "gaps",
          "args": [
            "$$.service",
            {
              "$literal": {
                "label": "Experience (military)",
                "title": [
                  "rank",
                  "role"
                ],
                "where": {
                  "kind": [
                    "military",
                    "reserve"
                  ]
                },
                "required": [
                  [
                    "rank",
                    "role"
                  ],
                  "startDate"
                ],
                "exact": [
                  "startDate",
                  "endDate"
                ],
                "names": {
                  "rank": "a title (rank or rate)",
                  "role": "role",
                  "startDate": "a start date"
                },
                "dateNames": {
                  "startDate": "start date",
                  "endDate": "end date"
                },
                "needMonth": true
              }
            }
          ]
        },
        {
          "$fn": "gaps",
          "args": [
            "$$.service",
            {
              "$literal": {
                "label": "Volunteering",
                "title": [
                  "role"
                ],
                "where": {
                  "kind": [
                    "scouting",
                    "volunteer",
                    "civic",
                    "board",
                    null
                  ]
                },
                "required": [],
                "exact": [
                  "startDate"
                ],
                "dateNames": {
                  "startDate": "start date",
                  "endDate": "end date"
                },
                "needMonth": false
              }
            }
          ]
        },
        {
          "$fn": "gaps",
          "args": [
            "$$.credentials",
            {
              "$literal": {
                "label": "License or certification",
                "required": [
                  "issuer"
                ],
                "names": {
                  "issuer": "an issuing organization"
                }
              }
            }
          ]
        },
        {
          "$fn": "gaps",
          "args": [
            "$$.publications",
            {
              "$literal": {
                "label": "Featured press",
                "where": {
                  "aboutPerson": [
                    true
                  ]
                },
                "required": [
                  "url"
                ],
                "names": {
                  "url": "a link or an uploaded PDF"
                }
              }
            }
          ]
        }
      ]
    }
  }
}
