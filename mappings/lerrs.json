{
  "target": "lerrs",
  "description": "HR Open Standards 4.5 LER-RS (Learning and Employment Record Resume Standard): the résumé document of the same release as the hropen Candidate, with the same entries and the same rules. Employment, education, licenses, certifications and skills go to their LER-RS lists; the summary is a narrative; languages are skills. Nothing here is a Verifiable Credential: every entry is the person's own statement. Service, publications, patents and references have no place in LER-RS and are left out (the hropen Candidate carries them).",
  "include": {
    "visibility": [
      "public"
    ],
    "status": [
      "approved"
    ],
    "confidence": [
      "high",
      "medium"
    ]
  },
  "orgNameStyle": "both",
  "ruleExemptKeys": [
    "id",
    "schemeId",
    "unitCode",
    "languageCode",
    "countryCode",
    "degreeGrantedStatus",
    "type",
    "resourceRelationshipCode",
    "workRelationshipTypeCode",
    "affiliationTypeCode",
    "status",
    "relationship",
    "schemeId"
  ],
  "output": {
    "type": "http://schema.hropenstandards.org/4.4/recruiting/json/ler-rs/LER-RSType.json",
    "person": {
      "name": {
        "formattedName": "$.person.name",
        "given": {
          "$fn": "name",
          "args": [
            "preferred",
            "given"
          ]
        },
        "family": {
          "$fn": "name",
          "args": [
            "preferred",
            "family"
          ]
        }
      }
    },
    "communication": {
      "address": [
        {
          "city": {
            "$fn": "place",
            "args": [
              "$.person.location",
              "locality"
            ]
          },
          "countrySubDivisions": [
            {
              "$if": {
                "$fn": "place",
                "args": [
                  "$.person.location",
                  "region"
                ]
              },
              "$then": {
                "type": "region",
                "value": {
                  "$fn": "place",
                  "args": [
                    "$.person.location",
                    "region"
                  ]
                }
              }
            }
          ],
          "countryCode": {
            "$fn": "place",
            "args": [
              "$.person.location",
              "countryCode"
            ]
          },
          "formattedAddress": {
            "$fn": "place",
            "args": [
              "$.person.location"
            ]
          }
        }
      ],
      "phone": [
        {
          "formattedNumber": {
            "$fn": "visible",
            "args": [
              "$.person.contact.phone",
              "$.person.contact.phoneVisibility"
            ]
          }
        }
      ],
      "email": [
        {
          "address": {
            "$fn": "visible",
            "args": [
              "$.person.contact.email",
              "$.person.contact.emailVisibility"
            ]
          }
        }
      ],
      "web": {
        "$fn": "concatLists",
        "args": [
          [
            {
              "$if": "$.person.contact.website",
              "$then": {
                "name": "Website",
                "url": "$.person.contact.website"
              }
            }
          ],
          {
            "$each": "$$.person.profiles",
            "$map": {
              "name": "$.network",
              "url": "$.url"
            }
          }
        ]
      }
    },
    "narratives": [
      {
        "$if": {
          "$fn": "coalesce",
          "args": [
            {
              "$fn": "text",
              "args": [
                "$.person.summary"
              ]
            },
            {
              "$fn": "text",
              "args": [
                "$.person.shortBio"
              ]
            }
          ]
        },
        "$then": {
          "name": {
            "$fn": "label",
            "args": [
              "hSummary"
            ]
          },
          "texts": [
            {
              "lines": [
                {
                  "$fn": "coalesce",
                  "args": [
                    {
                      "$fn": "text",
                      "args": [
                        "$.person.summary"
                      ]
                    },
                    {
                      "$fn": "text",
                      "args": [
                        "$.person.shortBio"
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      }
    ],
    "employmentHistories": {
      "$each": "$$.work",
      "$sort": "-startDate",
      "$map": {
        "id": {
          "value": "$.id"
        },
        "organization": {
          "name": {
            "$fn": "employer",
            "args": [
              "$.organization",
              "$.startDate",
              "$.endDate"
            ]
          },
          "domainName": {
            "$fn": "org",
            "args": [
              "$.organization",
              "url"
            ]
          }
        },
        "start": {
          "$fn": "isoExact",
          "args": [
            "$.startDate"
          ]
        },
        "end": {
          "$if": "$.current",
          "$then": null,
          "$else": {
            "$fn": "isoExact",
            "args": [
              "$.endDate"
            ]
          }
        },
        "current": "$.current",
        "descriptions": {
          "$fn": "concatLists",
          "args": [
            [
              {
                "$if": {
                  "$fn": "isoExact",
                  "args": [
                    "$.startDate"
                  ]
                },
                "$then": null,
                "$else": {
                  "$fn": "dateRangeText",
                  "args": [
                    "$.startDate",
                    "$.endDate",
                    "$.current"
                  ]
                }
              }
            ]
          ]
        },
        "positionHistories": {
          "$each": {
            "$fn": "positions",
            "args": [
              "$"
            ]
          },
          "$sort": "-startDate",
          "$map": {
            "id": {
              "value": "$.id"
            },
            "title": "$.title",
            "start": {
              "$fn": "isoExact",
              "args": [
                "$.startDate"
              ]
            },
            "end": {
              "$if": "$.current",
              "$then": null,
              "$else": {
                "$fn": "isoExact",
                "args": [
                  "$.endDate"
                ]
              }
            },
            "current": "$.current",
            "jobCategories": {
              "$each": {
                "$fn": "positionOccupations",
                "args": [
                  "$"
                ]
              },
              "$map": {
                "name": "$.title",
                "code": "$.code",
                "id": {
                  "value": "$.code",
                  "schemeId": "$.system"
                }
              }
            },
            "descriptions": {
              "$fn": "concatLists",
              "args": [
                [
                  {
                    "$if": {
                      "$fn": "isoExact",
                      "args": [
                        "$.startDate"
                      ]
                    },
                    "$then": null,
                    "$else": {
                      "$fn": "dateRangeText",
                      "args": [
                        "$.startDate",
                        "$.endDate",
                        "$.current"
                      ]
                    }
                  }
                ],
                [
                  "$.summary"
                ],
                {
                  "$fn": "responsibilityLines",
                  "args": [
                    "$"
                  ]
                },
                "$.jobMetrics"
              ]
            }
          }
        }
      }
    },
    "educationAndLearnings": {
      "$each": "$$.education",
      "$sort": "-endDate,-startDate",
      "$map": {
        "id": {
          "value": "$.id"
        },
        "institution": {
          "name": {
            "$fn": "org",
            "args": [
              "$.institution"
            ]
          },
          "domainName": {
            "$fn": "org",
            "args": [
              "$.institution",
              "url"
            ]
          }
        },
        "start": {
          "$fn": "isoExact",
          "args": [
            "$.startDate"
          ]
        },
        "end": {
          "$fn": "isoExact",
          "args": [
            "$.endDate"
          ]
        },
        "programs": [
          {
            "$fn": "text",
            "args": [
              "$.area"
            ]
          }
        ],
        "educationDegrees": [
          {
            "$if": "$.credential",
            "$then": {
              "name": {
                "$fn": "join",
                "args": [
                  [
                    "$.credential",
                    {
                      "$fn": "text",
                      "args": [
                        "$.area"
                      ]
                    }
                  ],
                  ", "
                ]
              },
              "date": {
                "$if": "$.completed",
                "$then": {
                  "$fn": "isoExact",
                  "args": [
                    "$.endDate"
                  ]
                }
              },
              "degreeGrantedStatus": {
                "$if": "$.completed",
                "$then": "Granted",
                "$else": {
                  "$if": {
                    "$fn": "oneOf",
                    "args": [
                      "$.completed",
                      false
                    ]
                  },
                  "$then": {
                    "$if": "$.endDate",
                    "$then": "NotGranted",
                    "$else": "InProgress"
                  }
                }
              }
            }
          }
        ],
        "descriptions": {
          "$fn": "concatLists",
          "args": [
            [
              {
                "$if": {
                  "$fn": "isoExact",
                  "args": [
                    "$.endDate"
                  ]
                },
                "$then": null,
                "$else": {
                  "$fn": "dateRangeText",
                  "args": [
                    "$.startDate",
                    "$.endDate",
                    null
                  ]
                }
              }
            ],
            [
              {
                "$fn": "text",
                "args": [
                  "$.summary"
                ]
              }
            ]
          ]
        }
      }
    },
    "licenses": {
      "$each": "$$.credentials",
      "$where": {
        "kind": [
          "license"
        ],
        "active": [
          true,
          null
        ]
      },
      "$sort": "-priority",
      "$map": {
        "id": {
          "$if": {
            "$fn": "visible",
            "args": [
              "$.credentialId",
              "$.credentialIdVisibility"
            ]
          },
          "$then": {
            "value": {
              "$fn": "visible",
              "args": [
                "$.credentialId",
                "$.credentialIdVisibility"
              ]
            }
          }
        },
        "name": {
          "$fn": "concat",
          "args": [
            {
              "$fn": "text",
              "args": [
                "$.name"
              ]
            },
            {
              "$if": "$.ratings",
              "$then": {
                "$fn": "concat",
                "args": [
                  " (",
                  {
                    "$fn": "join",
                    "args": [
                      "$.ratings"
                    ]
                  },
                  ")"
                ]
              }
            }
          ]
        },
        "issued": {
          "$fn": "isoExact",
          "args": [
            "$.issued"
          ]
        },
        "issuingAuthority": {
          "name": {
            "$fn": "coalesce",
            "args": [
              {
                "$fn": "org",
                "args": [
                  "$.issuer"
                ]
              },
              {
                "$fn": "label",
                "args": [
                  "issuerNotRecorded"
                ]
              }
            ]
          }
        },
        "descriptions": [
          {
            "$fn": "text",
            "args": [
              "$.summary"
            ]
          }
        ]
      }
    },
    "certifications": {
      "$fn": "concatLists",
      "args": [
        {
          "$each": "$$.credentials",
          "$where": {
            "kind": [
              "certification",
              "rating"
            ],
            "active": [
              true,
              null
            ]
          },
          "$sort": "-priority",
          "$map": {
            "id": {
              "$if": {
                "$fn": "visible",
                "args": [
                  "$.credentialId",
                  "$.credentialIdVisibility"
                ]
              },
              "$then": {
                "value": {
                  "$fn": "visible",
                  "args": [
                    "$.credentialId",
                    "$.credentialIdVisibility"
                  ]
                }
              }
            },
            "name": {
              "$fn": "concat",
              "args": [
                {
                  "$fn": "text",
                  "args": [
                    "$.name"
                  ]
                },
                {
                  "$if": "$.ratings",
                  "$then": {
                    "$fn": "concat",
                    "args": [
                      " (",
                      {
                        "$fn": "join",
                        "args": [
                          "$.ratings"
                        ]
                      },
                      ")"
                    ]
                  }
                }
              ]
            },
            "issued": {
              "$fn": "isoExact",
              "args": [
                "$.issued"
              ]
            },
            "issuingAuthority": {
              "name": {
                "$fn": "coalesce",
                "args": [
                  {
                    "$fn": "org",
                    "args": [
                      "$.issuer"
                    ]
                  },
                  {
                    "$fn": "label",
                    "args": [
                      "issuerNotRecorded"
                    ]
                  }
                ]
              }
            },
            "descriptions": [
              {
                "$fn": "text",
                "args": [
                  "$.summary"
                ]
              }
            ]
          }
        },
        {
          "$each": {
            "$fn": "badgesNotListed",
            "args": [
              "$$.badges"
            ]
          },
          "$sort": "-validFrom",
          "$map": {
            "id": {
              "value": "$.id"
            },
            "name": {
              "$fn": "text",
              "args": [
                "$.achievement.name"
              ]
            },
            "type": {
              "name": "Open Badge"
            },
            "issued": {
              "$fn": "date",
              "args": [
                "$.validFrom",
                "full"
              ]
            },
            "issuingAuthority": {
              "name": {
                "$fn": "coalesce",
                "args": [
                  {
                    "$fn": "org",
                    "args": [
                      "$.issuer"
                    ]
                  },
                  {
                    "$fn": "label",
                    "args": [
                      "issuerNotRecorded"
                    ]
                  }
                ]
              }
            },
            "descriptions": [
              {
                "$fn": "text",
                "args": [
                  "$.achievement.description"
                ]
              }
            ]
          }
        }
      ]
    },
    "skills": {
      "$fn": "concatLists",
      "args": [
        {
          "$each": "$$.skills",
          "$sort": "-pinned,-priority",
          "$map": {
            "name": {
              "$fn": "text",
              "args": [
                "$.name"
              ]
            },
            "yearsOfExperience": {
              "$fn": "wholeNumber",
              "args": [
                "$.years"
              ]
            },
            "comments": [
              {
                "$fn": "labelFor",
                "args": [
                  "level_",
                  "$.level"
                ]
              }
            ]
          }
        },
        {
          "$each": "$$.languages",
          "$map": {
            "name": {
              "$fn": "coalesce",
              "args": [
                {
                  "$fn": "text",
                  "args": [
                    "$.name"
                  ]
                },
                "$.language"
              ]
            },
            "comments": [
              {
                "$fn": "join",
                "args": [
                  [
                    {
                      "$fn": "labelFor",
                      "args": [
                        "fluency_",
                        "$.fluency"
                      ]
                    },
                    "$.cefr"
                  ],
                  {
                    "$fn": "label",
                    "args": [
                      "listSep"
                    ]
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
